# Copy to .env.platform-access for local private-model test runs.
# The same variable names are used by ../appbuildersdk.
# Credentials need ShapeDiver production Platform Backend API access with Models -> Read permission.

# ShapeDiver App Builder / platform client id used by appbuildersdk.
PLATFORM_CLIENT_ID="827bcbdc-8a5c-481a-b09a-e498074d91ca"

# Production platform access token credentials.
# If these two values are omitted, tests run through normal public ?slug= URLs.
PRODUCTION_PLATFORM_ACCESS_TOKEN_KEY=""
PRODUCTION_PLATFORM_ACCESS_TOKEN_SECRET=""
